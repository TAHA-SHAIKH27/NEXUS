# ── N.E.X.U.S. optional local settings ─────────────────────────────────
# Copy to `.env` and fill in ONLY what you use. Everything here is optional:
# NEXUS runs fully offline without any of these (local commands, timers,
# files, math, jokes, Hindi/Marathi/English offline replies all work).
#
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)

# Groq API key — cloud fallback for voice transcription only.
# Get one free at https://console.groq.com (or set it in the Settings UI).
GROQ_API_KEY=

# Local speech model name (informational default; browser voice does the work).
WHISPER_MODEL=base.en

# ── Phone mirroring (all optional; needs USB debugging + `adb` on PATH) ──
# Full path to adb.exe if it is not on PATH (e.g. C:\platform-tools\adb.exe)
NEXUS_ADB_PATH=adb
# Android lock-screen PIN used by "unlock my phone" when you don't say one.
# Keep this file private — never commit .env (it is gitignored).
NEXUS_PHONE_PIN=
# Full path to scrcpy.exe if it is not on PATH.
NEXUS_SCRCPY_PATH=

# ── Zetaris AI Data Gateway (optional; requires local Zetaris deployment) ──
# Zetaris UI origin (the web UI, NOT the internal API port)
ZETARIS_BASE_URL=http://localhost:3000
# Zetaris login email
ZETARIS_USERNAME=
# Zetaris login password
ZETARIS_PASSWORD=
# Numeric organization ID from Zetaris UI (Management → Organisation)
ZETARIS_ORG_ID=
# Default rows per query (1-100)
ZETARIS_DEFAULT_LIMIT=50
# Hard cap on rows per query (1-100)
ZETARIS_MAX_LIMIT=100
# Request timeout in seconds
ZETARIS_TIMEOUT_SECONDS=30
